# Base de datos (PostgreSQL) — docs/instrucciones.pdf sección 16
DB_URL=jdbc:postgresql://localhost:5432/academic_events_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Redis — docs/instrucciones.pdf sección 16
# host/port/password son los que consume application-*.yaml (elegido en vez de REDIS_URL).
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# REDIS_URL se documenta igual porque instrucciones.pdf la exige como variable mínima,
# pero el YAML actual no la lee (útil si un PaaS como Render/Upstash solo entrega una URL).
REDIS_URL=redis://localhost:6379

# JWT (HS256) — secret debe tener al menos 32 caracteres en prod. Expiraciones en milisegundos.
JWT_SECRET=dev-only-secret-please-change-me-min-32-chars
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# CORS — orígenes separados por coma
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Swagger/OpenAPI — credenciales de evaluación (HTTP Basic), solo exigidas en
# prod para /swagger-ui/** y /v3/api-docs/** (docs/instrucciones.pdf sección 11)
SWAGGER_USERNAME=admin
SWAGGER_PASSWORD=admin

# Servidor
PORT=8080

# Perfil activo (dev | prod)
SPRING_PROFILES_ACTIVE=dev
